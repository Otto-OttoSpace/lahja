{
  "name": "lahja",
  "version": "0.5.1",
  "description": "Find the user-facing strings AI code tools hardcode instead of translating \u2014 AST-verified so it never flags live code or dynamic bindings. CLI + MCP + AI-rules. Part of OttoSpace.",
  "bin": {
    "lahja": "bin/lahja.js",
    "i18nlint": "bin/lahja.js",
    "lahja-mcp": "mcp/lahja-mcp.js",
    "i18nlint-mcp": "mcp/lahja-mcp.js"
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/run.js test/catalog.test.js test/mcp-security.test.js"
  },
  "keywords": [
    "lahja",
    "i18nlint",
    "i18n",
    "l10n",
    "localization",
    "translation",
    "hardcoded-strings",
    "intl",
    "ast",
    "ai",
    "cursor",
    "claude",
    "linter"
  ],
  "author": "Othmane Morad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Otto-OttoSpace/lahja.git"
  },
  "homepage": "https://github.com/Otto-OttoSpace/lahja#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "lib",
    "mcp",
    "action.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Otto-OttoSpace"
  },
  "bugs": {
    "url": "https://github.com/Otto-OttoSpace/lahja/issues"
  }
}
